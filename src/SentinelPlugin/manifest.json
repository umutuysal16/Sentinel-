{
  "manifest_version": 3,
  "name": "Sentinel Browser Agent",
  "version": "1.0",
  "description": "Captures all console logs (info, debug, warn, error) from any website and sends them to Sentinel.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost:5052/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
