{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SentinelDb": "Host=localhost;Port=5432;Database=sentineldb;Username=postgres;Password=postgres"
  },
  "N8nSettings": {
    "WebhookUrl": "http://localhost:5678/webhook/analyze-log",
    "TimeoutSeconds": 30
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://*:5052",
        "Protocols": "Http1AndHttp2"
      },
      "Grpc": {
        "Url": "http://*:5053",
        "Protocols": "Http2"
      }
    }
  }
}
